# 复制本文件为 .env 后再填写本机配置。

# 后端项目路径。
# 如果保持默认目录结构，start.sh 会自动识别 ../kintsugi-dev，一般不用填写。
# KINTSUGI_ROOT=/absolute/path/to/kintsugi-dev

# 远程 token 模式必须填写；本机 local 模式不需要。
# ./Kintsugi_CVE_UI/start.sh token
KINTSUGI_BRIDGE_TOKEN=

# 可选：sudo 密码。
# 留空时，start.sh 会在交互式启动时询问一次。
KINTSUGI_SUDO_PASSWORD=

# LLM 服务商：deepseek、paratera 或 openrouter。
LLM_PROVIDER=deepseek

# 按选择的服务商填写对应 API Key。
DEEPSEEK_API_KEY=
PARATERA_API_KEY=
OPENROUTER_API_KEY=

# 实验服务登录信息。请只在本机 .env 中填写，不要提交真实值。
FLARUM_DB_ROOT_PASSWORD=
FLARUM_DB_PASSWORD=
FLARUM_ADMIN_PASSWORD=
PLONE_PASSWORD=
PGADMIN_PASSWORD=
LABEL_STUDIO_PASSWORD=
LABEL_STUDIO_USER_TOKEN=
CACTI_DB_ROOT_PASSWORD=
VUFIND_DB_ROOT_PASSWORD=
VUFIND_DB_PASSWORD=
CMSMS_DB_ROOT_PASSWORD=
CRAFTCMS_DB_ROOT_PASSWORD=
PHPMYADMIN_DB_ROOT_PASSWORD=
JOOMLA_DB_ROOT_PASSWORD=
PGADMIN_POSTGRES_PASSWORD=

# 可选：服务商地址和模型配置。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
PARATERA_BASE_URL=https://llmapi.paratera.com
PARATERA_MODEL=GLM-5.2
OPENROUTER_MODEL_KEY=deepseek-v3
